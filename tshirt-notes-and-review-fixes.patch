+# ---- 2: 使用中のカテゴリー設定はOFFにできない ---------------------------------------
+
+def _tee_form(**flags):
+    base = {"name": "Tシャツ", "sort_order": "0", "uses_color": "on", "uses_size": "on", "is_printable": "on"}
+    base.update(flags)
+    return {k: v for k, v in base.items() if v is not None}
